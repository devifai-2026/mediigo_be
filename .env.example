NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
LOG_LEVEL=debug

# --- Mongo Atlas (replica set required for transactions) ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mediigo?retryWrites=true&w=majority
MONGODB_DB_NAME=mediigo
MONGO_MAX_POOL_SIZE=10

# --- Auth ---
JWT_SECRET=change-me-to-32-or-more-random-characters
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
# HMAC key for Aadhaar hashing. NEVER rotate without a migration — every stored
# hash becomes unmatchable. A bare sha256 of a 12-digit number is brute-forceable,
# which is why this pepper is mandatory.
AADHAAR_HASH_PEPPER=change-me-to-32-or-more-random-characters

# --- OTP (env = fallback tier; the WaSettings document overrides at runtime) ---
OTP_DEMO=true
OTP_DEMO_CODE=1234
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- WhatsApp / WABridge (fallback tier; Super Admin UI overrides) ---
MESSAGING_PROVIDER=console
WABRIDGE_BASE_URL=https://web.wabridge.com/api
WABRIDGE_APP_KEY=
WABRIDGE_AUTH_KEY=
WABRIDGE_DEVICE_ID=
WABRIDGE_TEMPLATE_OTP=

# --- Google Maps Platform ---
# SERVER key — Geocoding API + Distance Matrix API.
# In the Cloud console set Application restrictions to "None" for local dev (a
# server sends no referrer, so a Websites restriction blocks every call), and
# switch to "IP addresses" on deploy. Restrict the APIs to those two.
# Separate from the browser key in client/.env.
GOOGLE_MAPS_API_KEY=XXXX
GOOGLE_MAPS_ENABLED=true
GOOGLE_GEOCODE_REGION=in
DISTANCE_MATRIX_MAX_DESTINATIONS=25
DISTANCE_CACHE_TTL_HOURS=6
DISTANCE_MATRIX_TIMEOUT_MS=2500
MAPS_BREAKER_COOLDOWN_MS=300000

# --- Search defaults ---
NEARBY_DEFAULT_RADIUS_KM=10
NEARBY_MAX_RADIUS_KM=50
NEARBY_MAX_HOSPITALS=40

# --- Rate limits ---
# Proxy hops in front of this service: Render's edge (1) + the frontend's
# server.js /api proxy (2). Too low and every proxied request appears to come
# from one IP, collapsing all users into a single rate-limit bucket.
TRUST_PROXY_HOPS=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MS=300000

# --- Business ---
DEFAULT_TIMEZONE=Asia/Kolkata
RECEIPT_PREFIX=MG
POLICY_BENCHMARK_VERSION=2025-26
MINUTES_PER_CONSULT=8
PLATFORM_FEE=20
